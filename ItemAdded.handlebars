{
    "content": "{{MentionType}}",
    "avatar_url": "{{AvatarUrl}}",
    "username": "{{{BotUsername}}}",
    "embeds": [
        {
            "author": {
                {{#if_equals ItemType 'Season'}}
                    "name": "Series Added - {{{SeriesName}}}",
                {{/if_equals}}

                {{#if_equals ItemType 'Season'}}
                    "name": "Season Added - {{{SeriesName}}} {{{Name}}}",
                {{/if_equals}}

                {{#if_equals ItemType 'Movie'}}
                    "name": "Movie Added - {{{Name}}}",
                {{/if_equals}}

                {{#if_equals ItemType 'Audio'}}
                    "name": "Album Added -{{{Album}}} by: {{{Artist}}}", 
                {{/if_equals}}

                "url": "{{ServerUrl}}/web/#/details?id={{ItemId}}&serverId={{ServerId}}"
            },
            
            "description": "
             {{~#if_exist Overview~}}
                > {{{Overview}}}\n\n
             {{~/if_exist~}}

             {{~#if_exist ServerUrl~}}
                [**Play Now** ]({{ServerUrl}}/web/#/details?id={{ItemId}}&serverId={{ServerId}})
             {{~/if_exist~}}

             {{~#if_exist Provider_imdb~}}
                {{~#if_equals ItemType 'Movie'~}}
                | [**IMDB** ](https://www.imdb.com/title/{{Provider_imdb}}/) 
                {{~/if_equals}}
             {{~/if_exist~}}

             {{~#if_exist Provider_tmdb~}}
                {{~#if_equals ItemType 'Movie'~}}
                | [**TMDB** ](https://www.themoviedb.org/movie/{{Provider_tmdb}})
                {{~/if_equals~}}
             {{~/if_exist~}}

             {{~#if_exist Provider_tvdb~}}
                {{~#if_equals ItemType 'Season'~}}
                | [**TVDB** ](https://www.thetvdb.com/series/{{Provider_tvdb}})
                {{~/if_equals~}}
             {{~/if_exist~}}

             {{~#if_exist Provider_applemusic~}}
                {{~#if_equals ItemType 'Audio'~}}
                | [**Apple Music**](https://music.apple.com/us/album/{{Provider_applemusic}})
                {{~/if_equals~}}
             {{~/if_exist~}}

             {{~#if_exist Provider_discogs~}}
                {{~#if_equals ItemType 'Audio'~}}
                | [**Discogs**](https://www.discogs.com/master/{{Provider_discogs}})
                {{~/if_equals~}}
             {{~/if_exist}}


             {{~#if_exist Provider_musicbrainzartist~}}
                {{~#if_equals ItemType 'Audio'~}}
                | [**MusicBrainz** ](https://musicbrainz.org/artist/{{Provider_musicbrainzartist}})
                {{~/if_equals~}}
             {{~/if_exist~}}

             {{~#if_exist Provider_musicbrainzalbum~}}
                | [**MusicBrainz Album** ](https://musicbrainz.org/release/{{Provider_musicbrainzalbum}})
             {{~/if_exist~}}

             {{~#if_exist Provider_lastfm~}}
                {{~#if_equals ItemType 'Audio'~}}
                [**Last.FM**](https://last.fm/music/{{Provider_lastfm}})
                {{~/if_equals~}}
             {{~/if_exist~}}
         
             ",
  
            "thumbnail" = {
              "url" =  "{{ServerUrl}}/Items/{{ItemId}}/Images/Primary"
            },

             "color": "3143327",

             "footer": {
                "text": "{{{ServerName}}} ",
                "icon_url": "{{AvatarUrl}}"
           
             "timestamp": "{{Timestamp}}"
             }
        }
    ]
}