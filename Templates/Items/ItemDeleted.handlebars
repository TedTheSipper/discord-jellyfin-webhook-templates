{
    "content": "{{MentionType}}", 
    "avatar_url": "{{AvatarUrl}}",
    "username": "{{{BotUsername}}}",
    "embeds": [
        {
            "author": {
                {{#if_equals ItemType 'Season'}}
                    "name": "Series Deleted - {{{SeriesName}}}",
                {{/if_equals}}

                {{#if_equals ItemType 'Season'}}
                    "name": "Season Deleted - {{{SeriesName}}} {{{Name}}}",
                {{/if_equals}}

                {{#if_equals ItemType 'Season'}}
                    "name": "Episode Deleted - {{{SeriesNumber00}}} / {{{SeriesName}}}",
                {{/if_equals}}

                {{#if_equals ItemType 'Movie'}}
                    "name": "Movie Deleted - {{{Name}}}",
                {{/if_equals}}

                {{#if_equals ItemType 'Audio'}}
                    "name": "Album Deleted - {{Artist}}", 
                {{/if_equals}}

                "url": "{{ServerUrl}}/web/#/details?id={{ItemId}}&serverId={{ServerId}}"
            },
            

            "thumbnail":{
                "url": "{{ServerUrl}}/Items/{{ItemId}}/Images/Primary"
            },

            "description": "
             {{~#if_exist Overview~}}
                > {{{Overview}}}\n\n
             {{~/if_exist~}}

             ",

             "color": "16715821",

             "footer": {
                "text": "{{{ServerName}}} ",
                "icon_url": "{{AvatarUrl}}"
             },

             "timestamp": "{{Timestamp}}"
        }
    ]
}